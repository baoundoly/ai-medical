# Application
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_ISSUER=AIClinicalAssistant

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_medical

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# File storage (S3-compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=ai-medical-files
AWS_REGION=ap-southeast-1

# AI / ML
OPENAI_API_KEY=
WHISPER_MODEL=base

# SMS / Email (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
